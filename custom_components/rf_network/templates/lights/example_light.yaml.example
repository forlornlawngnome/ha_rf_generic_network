# Example light template (e.g. a plug-in lamp or LED controller remote).
# Copy to <config>/rf_network/templates/lights/<name>.yaml and fill in.

name: Example brand RF light
type: light
frequency_mhz: 433.92
encoding: ev1527_24
address_bits: 20

# Lights work one of two ways. Fill in ONE of them (a fan's light uses the
# same block):
light:
  # 1. A single key that toggles. Home Assistant tracks on/off itself.
  toggle: "0001"
  # 2. Separate on and off keys. Home Assistant always knows the state.
  # on: "0001"
  # off: "0010"

  brightness_up: "0100"     # optional, shown as a Brighter button
  brightness_down: "1000"   # optional, shown as a Dimmer button
  # dim_step_repeats: 33    # optional: hold the key this many frames to dim
